; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="NES_Core_Template"
config/tags=PackedStringArray("starterkit")
run/main_scene="uid://bp4yx3qkbqsau"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/max_fps=60
config/icon="res://icon.svg"

[audio]

buses/default_bus_layout="uid://oy74e84g502i"

[autoload]

SaveManager="*uid://djrasagkg0hn"
MusicManager="*uid://c73donhi6hlfj"
SceneManager="*uid://b1d6doma6nynk"
NesSpriteManager="*uid://r6as0ry750x0"

[display]

window/size/viewport_width=384
window/size/viewport_height=216
window/size/resizable=false
window/subwindows/embed_subwindows=false
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"
window/vsync/vsync_mode=0

[dotnet]

project/assembly_name="NES_Core_Template"

[file_customization]

folder_colors={
"res://Assets/": "orange",
"res://Assets/Art/": "yellow",
"res://Assets/Audio/": "red",
"res://Scenes/": "blue",
"res://Scripts/": "gray"
}

